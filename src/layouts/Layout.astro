---
/* Shared flight-deck theme comes from the main site, checked out as the
   `theme` submodule. Only hubrun.css is local to this repo. */
import '../../theme/src/styles/main.css';
import 'lenis/dist/lenis.css';
import '../../theme/src/styles/header.css';
import '../../theme/src/styles/tape.css';
import '../../theme/src/styles/bottom-tape.css';
import '../../theme/src/styles/airlines.css';
import '../styles/hubrun.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '' } = Astro.props;
/* BASE_URL is '/' by default but has NO trailing slash when `base` is set in
   astro.config.mjs, so it can't just be concatenated. Normalise to one. */
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      /* Resolve panel state before first paint, matching the main site's own
         boot script exactly (theme/src/layouts/Layout.astro) — same
         localStorage key, same OS-preference fallback, same eventual default
         (SIA + dark, not Delta). site.ts reads lightsOn/gainOn off the
         data-panel-lights / data-panel-gain attributes set here, so this has
         to stay in step with upstream or the two sites disagree on defaults
         and, on a shared origin, on whichever livery the visitor last chose. */
      (function () {
        var root = document.documentElement;
        var lights = false;
        var gain = false;
        try {
          var saved = localStorage.getItem('panel-state');
          if (saved) {
            var s = JSON.parse(saved);
            lights = !!s.lights;
            gain = !!s.gain;
          } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
            lights = true;
            gain = true;
          }
        } catch (e) {
          /* private mode or blocked storage; defaults are fine */
        }
        root.setAttribute('data-airline', lights ? (gain ? 'united' : 'american') : (gain ? 'delta' : 'sia'));
        root.classList.toggle('dark', !lights);
        root.dataset.panelLights = lights ? 'on' : 'off';
        root.dataset.panelGain = gain ? 'on' : 'off';
      })();
    </script>
  </head>
  <body>
    <div class="hud-corner tl"></div>
    <div class="hud-corner tr"></div>
    <div class="hud-corner bl"></div>
    <div class="hud-corner br"></div>
    <slot />
  </body>
</html>
