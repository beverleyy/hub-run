---
import { capState, capabilities } from '../data/hubRun';

const microLabel = 'text-[0.58rem] uppercase tracking-[0.08em]';

const stateCaption = {
  trained: 'Trained',
  booked: 'Booked',
  untrained: 'Not yet',
} as const;

const rows = capabilities.map((c) => ({ ...c, state: capState(c.id) }));
const trained = rows.filter((r) => r.state === 'trained').length;
const booked = rows.filter((r) => r.state === 'booked').length;
const untrained = rows.filter((r) => r.state === 'untrained').length;
---
<div class="space-y-3">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <span class={`${microLabel} text-delta-red font-bold`}>Capability</span>
    <span class={`${microLabel} text-slate-500 dark:text-slate-500`}>
      {trained} trained &middot; {booked} booked &middot; {untrained} not yet
    </span>
  </div>

  <ul class="list-none m-0 p-0 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2">
    {rows.map((row) => (
      <li
        class="cap-cell bg-white dark:bg-slate-950 px-3 py-[0.8rem] flex flex-col gap-[0.35rem]"
        data-state={row.state}
      >
        <span class="flex items-center gap-2">
          <span class="cap-led" aria-hidden="true"></span>
          <span class="cap-name text-[0.72rem] font-bold uppercase tracking-[0.06em] text-slate-900 dark:text-slate-100">{row.label}</span>
        </span>
        <span class="text-[0.66rem] leading-[1.35] text-slate-500 dark:text-slate-500">{row.note}</span>
        <span class={`cap-state ${microLabel}`}>{stateCaption[row.state]}</span>
      </li>
    ))}
  </ul>
</div>
