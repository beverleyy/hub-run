---
import { siteMeta } from '../data/hubRun';

const linkClass = 'hover:text-delta-navy dark:hover:text-delta-sky transition';
---
<footer style="background-color:var(--panel-bg);" class="min-h-16 flex items-center px-6 py-3 border-t-2 border-slate-300 dark:border-slate-800 text-[9px] text-slate-400 dark:text-slate-600 uppercase tracking-widest transition-colors">
  <div class="max-w-7xl mx-auto w-full flex flex-col sm:flex-row items-center justify-center sm:justify-between gap-1.5 text-center sm:text-left">
    <span>
      &copy; {siteMeta.year} {siteMeta.author} &middot; Built with
      <a href="https://astro.build/" target="_blank" rel="noopener" style="color:inherit;" class={linkClass}>Astro</a>
      <span class="hidden sm:inline"> &middot; </span><br class="sm:hidden" />
      <a href={siteMeta.homeUrl} style="color:inherit;" class={linkClass}>Main site</a>
      &middot; &#127480;&#127468; &#9992;&#65039; &#127482;&#127480;
    </span>
    <span id="livery-credit">REG: N845MH</span>
  </div>
</footer>
